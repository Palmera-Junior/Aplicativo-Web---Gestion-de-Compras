DB_NAME=palmera_junior
DB_USER=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/palmera_junior
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# Requeridas solo con docker-compose.yml (login con Microsoft habilitado); no aplican con docker-compose.no-oauth2.yml
MICROSOFT_OAUTH2_ENABLED=true
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# URI registrado en Microsoft Entra ID; el Compose OAuth2 publica Nginx en localhost:8080.
MICROSOFT_REDIRECT_URI=http://localhost:8080/login/oauth2/code/microsoft
MAIL_FROM_ADDRESS=notificaciones@palmerajunior.com
MAIL_FROM_NAME=Notificaciones Palmera Junior
CONTABILIDAD_NOTIFICACION_EMAIL=contabilidad@palmerajunior.com
AWS_ACCESS_KEY_ID_SES=
AWS_SECRET_ACCESS_KEY_SES=
AWS_DEFAULT_REGION_SES=us-east-1
JAVA_OPTS=-Xmx2g -Xms512m
SESSION_COOKIE_SECURE=false
